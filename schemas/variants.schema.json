{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variants.schema.json",
  "title": "VariantsFile",
  "type": "object",
  "required": ["variants"],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "ret_thresh", "lookback", "rsi_thresh", "pb_thresh", "hold_days"],
        "properties": {
          "code": {"type": "string"},
          "description": {"type": "string"},
          "ret_thresh": {"type": "number"},
          "lookback": {"type": "integer"},
          "rsi_thresh": {"type": "number"},
          "pb_thresh": {"type": "number"},
          "hold_days": {"type": "integer"},
          "frozen": {"type": "boolean"},
          "active_lab": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
