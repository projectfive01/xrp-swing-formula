{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sol_day_paper_trade.schema.json",
  "title": "SOL Day v3 Paper Trade",
  "type": "object",
  "required": ["id", "status", "direction", "entry_ts", "entry_px", "stop_px", "formula_version"],
  "properties": {
    "id": {"type": "string"},
    "status": {"type": "string", "enum": ["OPEN", "CLOSED", "STOPPED", "CANCELLED"]},
    "direction": {"type": "string", "enum": ["long", "short"]},
    "formula_version": {"type": "string"},
    "entry_ts": {"type": "string"},
    "exit_ts": {"type": ["string", "null"]},
    "entry_px": {"type": "number"},
    "exit_px": {"type": ["number", "null"]},
    "stop_px": {"type": "number"},
    "tp3_px": {"type": ["number", "null"]},
    "tp4_px": {"type": ["number", "null"]},
    "r_value": {"type": ["number", "null"]},
    "size_sol": {"type": ["number", "null"]},
    "risk_usd": {"type": ["number", "null"]},
    "equity_unit_usd": {"type": ["number", "null"]},
    "pnl_r": {"type": ["number", "null"]},
    "pnl_usd": {"type": ["number", "null"]},
    "mae_r": {"type": ["number", "null"]},
    "mfe_r": {"type": ["number", "null"]},
    "exit_reason": {"type": ["string", "null"]},
    "signal_ts": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
